; Dallarian — jogo 3D em primeira pessoa (Godot 4.5), visual PS1 pintado + pixel splats
config_version=5

[application]
config/name="Dallarian"
run/main_scene="res://cenas/mundo.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0

[shader_globals]
neb_ini={
"type": "float",
"value": 40.0
}
neb_fim={
"type": "float",
"value": 270.0
}
neblina_ceu={
"type": "float",
"value": 0.0
}
luz_ambiente={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
lanterna0={
"type": "vec4",
"value": Vector4(0, -1000, 0, 0)
}
lanterna1={
"type": "vec4",
"value": Vector4(0, -1000, 0, 0)
}
lanterna2={
"type": "vec4",
"value": Vector4(0, -1000, 0, 0)
}
lanterna3={
"type": "vec4",
"value": Vector4(0, -1000, 0, 0)
}
lanterna4={
"type": "vec4",
"value": Vector4(0, -1000, 0, 0)
}
lanterna5={
"type": "vec4",
"value": Vector4(0, -1000, 0, 0)
}
noite={
"type": "float",
"value": 0.0
}
forca_vento={
"type": "float",
"value": 1.0
}
chuva={
"type": "float",
"value": 0.0
}
relampago={
"type": "float",
"value": 0.0
}
